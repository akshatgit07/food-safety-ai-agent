OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
USDA_API_KEY=
ALLOWED_ORIGINS=http://localhost:3000
DATABASE_URL=postgresql://user:password@localhost/nutrition
CATALOG_SEED_DEMO=true
# local cosine works on SQLite/Postgres; pgvector is optional and needs the extension.
CATALOG_VECTOR_BACKEND=local
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=food-safety-ai-agent
LANGSMITH_HIDE_INPUTS=true
LANGSMITH_HIDE_OUTPUTS=true
# Optional for organization-scoped LangSmith keys:
LANGSMITH_WORKSPACE_ID=
